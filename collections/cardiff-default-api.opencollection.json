{
  "opencollection": "1.0.0",
  "info": {
    "name": "CoursesApi Assessments * API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "implicit",
      "authorizationUrl": "https://api.data.cardiff.ac.uk/authorize",
      "credentials": {
        "clientId": "{{clientId}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "*",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /*",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.data.cardiff.ac.uk/courses/v1/*",
            "params": [
              {
                "name": "in",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "implicit",
              "authorizationUrl": "https://api.data.cardiff.ac.uk/authorize",
              "credentials": {
                "clientId": "{{clientId}}"
              }
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}