{
  "opencollection": "1.0.0",
  "info": {
    "name": "CoursesApi Assessments Qualifications API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "implicit",
      "authorizationUrl": "https://api.data.cardiff.ac.uk/authorize",
      "credentials": {
        "clientId": "{{clientId}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Qualifications",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve a list of all available qualifications used within the Univesity.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.data.cardiff.ac.uk/courses/v1/qualifications",
            "params": [
              {
                "name": "school",
                "value": "",
                "type": "query",
                "description": "Returns qualifications linked to the specified school code e.g. SOCSI (Social Sciences)"
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Filters modules by programme type. Accepted values: P (Postgraduate), R (Research) or U (Undergraduate). (Note: This parameter is case sensitive.)"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of qualifications to return"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Offset of qualifications to return"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Sorts the data by column name, use \"-\" for descending"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "implicit",
              "authorizationUrl": "https://api.data.cardiff.ac.uk/authorize",
              "credentials": {
                "clientId": "{{clientId}}"
              }
            }
          },
          "docs": "Retrieve a list of all available qualifications used within the Univesity."
        }
      ]
    }
  ],
  "bundled": true
}